# Copiá este archivo a .env y completalo. .env no se commitea.

# Proyecto de GCP donde corre Speech-to-Text (chirp_3) y se crean los buckets temporales. Obligatorio.
GCP_PROYECTO=mi-proyecto-gcp

# API key de Anthropic para generar resumen.md. Opción A: ponerla acá o exportarla en la shell.
# ANTHROPIC_API_KEY=

# Opción B: nombre de un secreto de Secret Manager (en GCP_PROYECTO) que contiene la key.
# Se lee en el momento con gcloud y solo queda en memoria.
# TRANSCRIPCIONES_SECRETO=anthropic-api-key

# Opcional: contexto de la organización para el resumen (agrega la sección "Relevante para ...").
# ORGANIZACION=ACME, una empresa de software de salud

# Opcional: carpeta de salida (por defecto ./output, ignorada por git).
# TRANSCRIPCIONES_OUTPUT=
